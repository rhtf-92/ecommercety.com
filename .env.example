# Copia este archivo como .env para desarrollo (la CLI de Prisma solo
# lee .env, no .env.local). Nunca subas secretos al repo.

# Base de datos PostgreSQL (coincide con docker-compose.yml, puerto 5433;
# o usa tu URL de Neon)
DATABASE_URL="postgresql://ecommercety:ecommercety@localhost:5433/ecommercety?schema=public"

# URL pública del sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nombre público de la marca
NEXT_PUBLIC_BRAND_NAME="T&F Picks"

# Credenciales de la Amazon Creators API (la oficial; PA-API fue retirada
# en 2026). Amazon solo las emite con la cuenta aprobada y 10+ ventas
# calificadas en los últimos 30 días. Sin ellas, el sitio no muestra
# precios (política de cumplimiento) y usa "Check price on Amazon".
# Los nombres deben ser exactamente estos: son los que lee el código.
CREATORS_API_CREDENTIAL_ID=""
CREATORS_API_CREDENTIAL_SECRET=""

# Panel de administración (valores SOLO en .env / secretos del hosting)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET="una-cadena-larga-y-aleatoria-de-32-o-mas-caracteres"

# Verificación de propiedad en buscadores (opcional; alternativa al
# registro TXT en DNS). Google Search Console y Bing Webmaster
# entregan un código al crear la propiedad: pégalo aquí en el
# entorno de PRODUCCIÓN (Railway) y vuelve a desplegar.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
