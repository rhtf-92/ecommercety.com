# Copia este archivo como .env.local para desarrollo. Nunca subas secretos al repo.

# Base de datos PostgreSQL (coincide con docker-compose.yml; o usa tu URL de Neon)
DATABASE_URL="postgresql://ecommercety:ecommercety@localhost:5433/ecommercety?schema=public"

# URL pública del sitio
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Nombre público de la marca
NEXT_PUBLIC_BRAND_NAME="T&F Picks"

# (Futuro) Credenciales de la API oficial de Amazon (Creators API / PA API),
# solo cuando la cuenta Associates califique. No usar scraping.
AMAZON_API_ACCESS_KEY=""
AMAZON_API_SECRET_KEY=""

# Panel de administración (valores SOLO en .env.local / secretos del hosting)
ADMIN_EMAIL=
ADMIN_PASSWORD=
SESSION_SECRET=